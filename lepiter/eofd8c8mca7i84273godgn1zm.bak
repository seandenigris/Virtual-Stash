								"uidString" : "zNBrWIhoTh67NFphRWzxUw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "- What has this vehicle cost?\n- Which expenses supported this project?\n- Which agreements renew next month?\n- What did this software cost over its lifetime?\n- Who benefited from this purchase?"
						}
