				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Virtual Stash is not merely multidimensional accounting.\n\n**We release bookkeeping objects into the rest of the Dynabook.**"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-08-04T09:51:26.722395-04:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-08-04T09:51:26.722395-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "AGAAtVP3TKuI6rmcK6GVDQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "A person is not a tag.\n\nA project is not a category.\n\nAn insurance policy is not memo text."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-08-04T09:51:26.722612-04:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-08-04T10:14:51.762112-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "HkYIpseWT+SjT/WZyG0uzA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "{{gtClass:CwSoftware|label=Software}}, {{gtClass:PpVehicle|label=vehicles}}, {{gtClass:VsAgreement|label=agreements}}, {{gtClass:PpEvent|label=events}}, {{gtClass:PpInventory|label=inventory}}, places, and {{gtClass:MpPerson|label=people}} remain real objects with their own behavior and history.\n\n{{gtClass:MpPerson|label=people}}, {{gtClass:PpProject|label=projects}}, {{gtClass:VsAgreement|label=agreements}}, {{gtClass:PpLocation|label=places}}, possessions, and {{gtClass:PpValue|label=purposes}} that give them meaning\n\nA posting links to them rather than flattening them into labels."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
